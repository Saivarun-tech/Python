class Solution:
    def rotateRight(self, head: ListNode | None, k: int) -> ListNode | None:
        if head is None or head.next is None or k == 0:
            return head

        # Find the length and the current tail.
        length = 1
        tail = head
        while tail.next is not None:
            tail = tail.next
            length += 1

        # A full-length rotation leaves the list unchanged.
        shift = k % length
        if shift == 0:
            return head

        # Temporarily make the list circular, then break it at the new tail.
        tail.next = head
        steps_to_new_tail = length - shift - 1
        new_tail = head
        for _ in range(steps_to_new_tail):
            new_tail = new_tail.next

        new_head = new_tail.next
        new_tail.next = None
        return new_head
