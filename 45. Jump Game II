class Solution:
    def jump(self, nums: List[int]) -> int:
        jumps = 0
        current_end = 0
        farthest = 0

        # The final position does not require another jump.
        for i in range(len(nums) - 1):
            farthest = max(farthest, i + nums[i])

            # We've reached the end of the current jump's coverage.
            if i == current_end:
                jumps += 1
                current_end = farthest

        return jumps
