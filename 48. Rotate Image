class Solution:
    def rotate(self, matrix: list[list[int]]) -> None:
        """Rotate the square matrix 90 degrees clockwise in place."""
        n = len(matrix)

        # Transpose across the main diagonal.
        for i in range(n):
            for j in range(i + 1, n):
                matrix[i][j], matrix[j][i] = matrix[j][i], matrix[i][j]

        # Reverse each row.
        for row in matrix:
            row.reverse()
