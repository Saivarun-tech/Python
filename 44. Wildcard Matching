class Solution:
    def isMatch(self, s: str, p: str) -> bool:
        # Greedy matching: remember the most recent '*' and the
        # input position it currently matches.
        i = j = 0
        star = -1
        star_match = 0

        while i < len(s):
            if j < len(p) and (p[j] == '?' or p[j] == s[i]):
                i += 1
                j += 1
            elif j < len(p) and p[j] == '*':
                star = j
                star_match = i
                j += 1
            elif star != -1:
                # Let the last '*' consume one more character, then retry
                # the pattern characters following it.
                star_match += 1
                i = star_match
                j = star + 1
            else:
                return False

        # Any remaining pattern characters must all be '*'.
        while j < len(p) and p[j] == '*':
            j += 1

        return j == len(p)
