from collections import deque

class Solution:
    def zigzagLevelOrder(self, root: Optional[TreeNode]) -> List[List[int]]:
        if not root:
            return []

        ans = []
        q = deque([root])
        left_to_right = True

        while q:
            n = len(q)
            level = [0] * n

            for i in range(n):
                node = q.popleft()

                index = i if left_to_right else n - 1 - i
                level[index] = node.val

                if node.left:
                    q.append(node.left)

                if node.right:
                    q.append(node.right)

            ans.append(level)
            left_to_right = not left_to_right

        return ans
