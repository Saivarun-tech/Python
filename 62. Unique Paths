class Solution:
    def uniquePaths(self, m: int, n: int) -> int:
        k = min(m, n) - 1          # choose the smaller side to keep the loop short
        total = m + n - 2
        result = 1
        for i in range(1, k + 1):
            result = result * (total - k + i) // i  # always divisible at each step
        return result
