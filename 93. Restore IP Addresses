
class Solution:
    def restoreIpAddresses(self, s: str) -> list[str]:
        n = len(s)
        if n < 4 or n > 12:
            return []

        result = []
        path = []

        def backtrack(i):
            parts = len(path)
            remaining = n - i
            slots = 4 - parts

            if remaining < slots or remaining > slots * 3:
                return

            if parts == 4:
                if i == n:
                    result.append(".".join(path))
                return

            for j in range(i + 1, min(i + 4, n + 1)):
                segment = s[i:j]

                if len(segment) > 1 and segment[0] == '0':
                    break

                if int(segment) > 255:
                    break

                path.append(segment)
                backtrack(j)
                path.pop()

        backtrack(0)
        return result
